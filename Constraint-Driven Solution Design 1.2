T = int(input())

for _ in range(T):
    s = input().strip()
    n = len(s)

    mid = n // 2

    if n % 2 == 0:
        left = s[:mid]
        right = s[mid:]
    else:
        left = s[:mid]
        right = s[mid + 1:]

    if sorted(left) == sorted(right):
        print("YES")
    else:
        print("NO")
